{
  "Infrastructure": {
    "UseLocalFallbacks": false
  },
  "Api": {
    "BaseUrl": "https://api.staging.example.com"
  },
  "SqlServer": {
    "ConnectionString": "Server=sql.staging.example.com,1433;Database=BaseWebApi_Staging;User Id=sa;Password=STAGING_PASSWORD;TrustServerCertificate=True;Encrypt=True;Connect Timeout=5"
  },
  "Oracle": {
    "Enabled": false,
    "ConnectionString": "User Id=app;Password=STAGING_ORACLE;Data Source=oracle.staging.example.com:1521/XEPDB1"
  },
  "Redis": {
    "Configuration": "redis.staging.example.com:6379",
    "InstanceName": "BaseWebApi:Staging:"
  },
  "Minio": {
    "Endpoint": "minio.staging.example.com:9000",
    "AccessKey": "STAGING_MINIO_ACCESS",
    "SecretKey": "STAGING_MINIO_SECRET",
    "BucketName": "basewebapi-staging",
    "UseSsl": true
  },
  "Kafka": {
    "BootstrapServers": "kafka.staging.example.com:9092",
    "ClientId": "basewebapi-staging",
    "DefaultTopic": "enterprise.events.staging"
  },
  "Elasticsearch": {
    "Url": "https://elastic.staging.example.com:9200",
    "DefaultIndex": "basewebapi-staging",
    "Username": "elastic",
    "Password": "STAGING_ELASTIC_PASSWORD"
  },
  "Jwt": {
    "Issuer": "BaseWebApi.Staging",
    "Audience": "BaseWebApi.Clients.Staging",
    "SigningKey": "STAGING_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "FilePath": "logs/basewebapi-staging-.log"
  }
}
