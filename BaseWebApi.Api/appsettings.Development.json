{
  "Infrastructure": {
    "UseLocalFallbacks": true
  },
  "Api": {
    "BaseUrl": "https://localhost:5001"
  },
  "SqlServer": {
    "ConnectionString": "Server=localhost,1433;Database=BaseWebApi_Dev;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;Encrypt=False;Connect Timeout=5"
  },
  "Oracle": {
    "Enabled": false,
    "ConnectionString": "User Id=system;Password=oracle;Data Source=localhost:1521/XEPDB1"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "BaseWebApi:Dev:"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "basewebapi-dev",
    "UseSsl": false
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "basewebapi-dev",
    "DefaultTopic": "enterprise.events.dev"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "DefaultIndex": "basewebapi-dev"
  },
  "Jwt": {
    "Issuer": "BaseWebApi.Dev",
    "Audience": "BaseWebApi.Clients.Dev",
    "SigningKey": "DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32CHARS",
    "ExpirationMinutes": 240
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "FilePath": "logs/basewebapi-development-.log"
  }
}
